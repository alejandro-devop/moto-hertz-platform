# Variables de producción para docker-compose.prod.yml (Fase 7).
# Copiar a .env.prod en el droplet (NUNCA versionar .env.prod con valores reales).

# --- Base de datos ---
DB_NAME=yamaha_oriente_db
DB_USER=yamaha_user
DB_PASSWORD=change-me

# --- Auth admin único (cms-admin) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@yamahaoriente.com
# Hash bcrypt de la contraseña real del admin. Generar con:
#   node -e "console.log(require('bcryptjs').hashSync('tu-password', 10))"
# IMPORTANTE: Docker Compose interpola "$" dentro de los .env que carga con
# --env-file, igual que en el YAML — un hash bcrypt normal (formato $2b$10$...)
# se corrompe silenciosamente (trunca todo lo que sigue al primer "$" no escapado).
# Hay que escapar cada "$" del hash como "$$" aquí, ej.:
#   ADMIN_PASSWORD_HASH=$$2b$$10$$abcdefghijklmnopqrstuvwxyz
ADMIN_PASSWORD_HASH=

# --- Dominios (sin protocolo, sin barra final) ---
WEB_DOMAIN=yamahaoriente.com
CMS_DOMAIN=admin.yamahaoriente.com
API_DOMAIN=api.yamahaoriente.com
