# Server Configuration
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Database (local Docker Compose / Cloud SQL en producción)
DB_HOST=localhost
DB_PORT=5432
DB_USER=yamaha_user
DB_PASSWORD=yamaha_password
DB_NAME=yamaha_oriente_db

# Cloud SQL (para despliegue en Cloud Run)
CLOUD_SQL_CONNECTION_NAME=

# Redis (Memorystore / Redis local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ENABLE_REDIS_CACHE=true

# CORS - orígenes adicionales (separados por coma o pipe)
ALLOWED_ORIGINS=http://localhost:3000|http://localhost:5173|http://localhost:8080

# Google Cloud Platform (para Cloud Run)
GCP_PROJECT=
GCP_REGION=us-central1

# Autenticación admin único (cms-admin) — sin tabla de usuarios (Fase 3)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@yamahaoriente.com
# Hash bcrypt de la contraseña del admin. Generar con:
#   node -e "console.log(require('bcryptjs').hashSync('tu-password', 10))"
ADMIN_PASSWORD_HASH=

# Medios (Fase 1 del plan CMS) — ver src/shared/storage/README.md
# Driver de almacenamiento. Hoy solo existe `local`; S3/GCS se agregan como un
# archivo nuevo en src/shared/storage/ sin tocar services ni resolvers.
STORAGE_DRIVER=local
# Carpeta del driver local. En Docker es el volumen `media_data`.
MEDIA_ROOT=./uploads
# Prefijo con el que se arma la URL pública que se guarda en el contenido.
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
# Tamaño máximo del archivo que llega; lo que se guarda es un WebP más liviano.
MEDIA_MAX_UPLOAD_MB=15
