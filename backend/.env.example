# Server Configuration
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Database (local Docker Compose / Cloud SQL en producción)
DB_HOST=localhost
DB_PORT=5432
DB_USER=yamaha_user
DB_PASSWORD=yamaha_password
DB_NAME=yamaha_oriente_db

# Cloud SQL (para despliegue en Cloud Run)
CLOUD_SQL_CONNECTION_NAME=

# Redis (Memorystore / Redis local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ENABLE_REDIS_CACHE=true

# CORS - orígenes adicionales (separados por coma o pipe)
ALLOWED_ORIGINS=http://localhost:3000|http://localhost:5173|http://localhost:8080

# Google Cloud Platform (para Cloud Run)
GCP_PROJECT=
GCP_REGION=us-central1
